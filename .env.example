# Copy to .env. `picnic-saver login` fills in PICNIC_AUTH_KEY for you.
# The password is never stored.

# The country of your Picnic account: DE (default), NL or FR.
PICNIC_COUNTRY_CODE=DE

# Optional: prefills the e-mail prompt of `picnic-saver login`.
PICNIC_EMAIL=

# Written by `picnic-saver login`, removed by `picnic-saver logout`.
PICNIC_AUTH_KEY=
